# ─── Database ────────────────────────────────────────────────────────────────
# Get this from your Neon project dashboard → Connection string
# Use the "pooled" connection string for serverless (ends in ?sslmode=require)
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# The URL of your app (no trailing slash)
AUTH_URL=http://localhost:3000

# ─── Apple Sign In ────────────────────────────────────────────────────────────
# 1. Go to developer.apple.com → Certificates, IDs & Profiles
# 2. Create an App ID with "Sign In with Apple" enabled
# 3. Create a Services ID (this is AUTH_APPLE_ID, e.g. com.yourcompany.property-saas)
# 4. Create a Key with "Sign In with Apple" enabled, download the .p8 file
# 5. Generate the client secret JWT with the command below (replace values):
#
#    npx auth add apple
#    — or manually:
#    AUTH_APPLE_ID=       → Services ID (e.g. com.yourcompany.app)
#    AUTH_APPLE_SECRET=   → JWT generated from your .p8 private key
#
# The client secret is a JWT signed with ES256. It expires after 6 months max.
# Re-run the generator before it expires.
AUTH_APPLE_ID=com.yourcompany.property-saas
AUTH_APPLE_SECRET=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Google Sign In ───────────────────────────────────────────────────────────
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add authorised redirect URI: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
